apiVersion: tekton.dev/v1
kind: PipelineRun
metadata:
  name: jx3-release-python-package
spec:
  # IMPORTANT: DO NOT MODIFY BELOW THIS COMMENT
  # This section is managed by the DEVEXP team.
  # Any modifications may cause unintended issues.
  pipelineRef:
    resolver: dm-git
    params:
      - name: revision
        value: main
      - name: pathInRepo
        value: /dm-standard/pipelines/dm-release-python-package/v1/pipeline.yaml
  workspaces:
    - name: gar-outils-dockerconfig-ws
      secret:
        secretName: gar-outils-dockerconfig-secrets
    - name: harbor-dockerconfig-ws
      secret:
        secretName: harbor-dockerconfig-secrets
    - name: quay-dockerconfig-ws
      secret:
        secretName: quay-dockerconfig-secrets
    - name: python-package-build-ws
      emptyDir: {}
    - name: shared-workspace
      emptyDir: {}
  taskRunTemplate:
    serviceAccountName: tekton-bot
  timeouts:
    pipeline: 00h30m0s
